  Content-Security-Policy: default-src 'none'; script-src 'sha256-q43+E5gmFxyiLX0ydXPd7ELmS/wOwYAZy2cJ1EtsMPM=' 'sha256-B8pYtCE5vont4CmN8m9fkgUEgvjkquJFlLV1jAzfplE=' 'sha256-9+dHnzXS+yGefXYs8PBCd0Np99qdpsYz99ud7F91aHA=' 'sha256-waMXmOtbHalwLhIKSyPlOls4W5Ej/tcZBW9G9VSU7L4=' 'sha256-edsZECIUq7ybADKzbOsnJsbBLZ8hvnmsT2/esmKSSUs=' 'sha256-U1AwtSCjq2PmNqAIZxFXPIZP8FK3nGi9zSKTR55GEFQ='; style-src 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src data:; connect-src 'self' https://api.github.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
