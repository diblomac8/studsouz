# Защитные заголовки сайта Студенческого союза МГИМО.
# Работают на Netlify и Cloudflare Pages: файл должен лежать в корне сайта рядом с index.html.
# Content-Security-Policy разрешает только скрипты самого сайта (по хэшам), загрузку данных с этого же сайта и обращения редактора к api.github.com (публикация выпуска);
# запрещает чужие скрипты, отправку данных на другие сайты и встраивание сайта в чужие страницы.
# После правки HTML-страниц файл нужно пересобрать (build/headers.py). Обновление digest.json его не затрагивает.
/*
  Content-Security-Policy: default-src 'none'; script-src 'sha256-q43+E5gmFxyiLX0ydXPd7ELmS/wOwYAZy2cJ1EtsMPM=' 'sha256-4/aSIzFjwPRScQgJhrCSqFY/ZPV5gRxTKZm7hHHX+6k=' 'sha256-oAKIVuPGW83AcqdgpkDxctCPjFqJ6kSNyATZSzMQAk4=' 'sha256-4ZZmGRxict2DH6NIOqEBe+rBkb9lVAfIJ1dU9xBNYpc=' 'sha256-SVr9+h5E/ySNIfDnJ3WLM39YNsZpAwDxgKtghgBYlk4=' 'sha256-x5V8EZh7RZ4rjXY9Bng01PBBsZQuyflC08l6WsGBsLg=' 'sha256-U1AwtSCjq2PmNqAIZxFXPIZP8FK3nGi9zSKTR55GEFQ='; style-src 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src data:; connect-src 'self' https://api.github.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
